MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5966130842775869166}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 39ee76be658a60e4fb219b5b444ba8aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::dailogue_appear
  Textcompo: {fileID: 7023075435292583424}
  lines:
  - Ram Ram! I am a humble Mavala of these hills.
  - Many have tried to climb this fort, but only those with the heart of a lion and
    the grip of a monitor lizard (Ghorpad) reach the top.
  - "I\u2019ve been sent to ensure you don\u2019t fall at the first gate. "
  - "I\u2019ll be your guide and your harshest critic. "
  - "Let\u2019s see if you have what it takes to stand before Maharaj."
  textspeed: 0.05
